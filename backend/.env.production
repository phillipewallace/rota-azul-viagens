
# Configurações para VPS - AlchemyRotas
# Copie este arquivo para .env na VPS e ajuste os valores

# Configurações do Servidor
NODE_ENV=production
PORT=3001

# Configurações do Banco PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alchemy_rotas
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Configurações de Segurança
JWT_SECRET=sua_chave_jwt_super_secreta_aqui_128_caracteres_minimo
BCRYPT_ROUNDS=12

# Configurações de CORS (adicione o domínio da sua VPS)
ALLOWED_ORIGINS=http://localhost:3000,https://seu-dominio.com

# Google Maps API (se usar)
GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# Configurações de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-email

# Configurações de Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/var/uploads/alchemy-rotas

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
